#!/usr/bin/env bash
# Hard-enforce the branching policy: only `main` may be pushed, and only to `origin` (EmiOS-Beta).
#
# Why: agents repeatedly create stray branches (release-v0.1, feature/*, etc.)
# and/or push to the wrong remote (alpha-legacy). This hook makes both mistakes fatal.
#
# Trigger: any pre-push event. Fails non-zero -> push aborts.
#
# Args (set by git):
#   $1 = remote name (e.g. "origin")
#   $2 = remote URL  (e.g. "https://github.com/.../EmiOS-Beta.git")
# Stdin: one line per ref being pushed:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>

set -eu

remote_name="$1"
remote_url="$2"

# Read stdin into a buffer — we have to consume it before deciding so git's
# pipe doesn't break.
refs="$(cat)"

# ---------- Rule 1: every push must target `origin` (EmiOS-Beta). ----------
case "$remote_name" in
    origin)
        case "$remote_url" in
            *EmiOS-Beta*|*emios-beta*) : ;; # OK
            *)
                echo ""                                                                  >&2
                echo "BLOCKED: 'origin' does not look like the EmiOS-Beta repo."         >&2
                echo "  remote: $remote_name"                                            >&2
                echo "  url:    $remote_url"                                             >&2
                echo ""                                                                  >&2
                echo "Reset origin to EmiOS-Beta:"                                       >&2
                echo "  git remote set-url origin <EmiOS-Beta URL>"                      >&2
                echo ""                                                                  >&2
                exit 1
                ;;
        esac
        ;;
    *)
        echo ""                                                                          >&2
        echo "BLOCKED: pushes are only allowed to remote 'origin' (EmiOS-Beta)."         >&2
        echo "You targeted '$remote_name' ($remote_url)."                                >&2
        echo ""                                                                          >&2
        echo "If you really need to push to another remote, do it deliberately by"       >&2
        echo "editing scripts/git-hooks/pre-push — and update CLAUDE.md to match."       >&2
        echo ""                                                                          >&2
        exit 1
        ;;
esac

# ---------- Rule 2: only branch `main` may be pushed. ----------
# Allow deletes (local_sha all zeros) so we can clean up stray branches that
# already exist on the remote.
pushing_commits=0   # set when a real (non-delete) commit push to main is seen
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${remote_ref:-}" ] && continue
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;  # delete is fine
    esac
    case "$remote_ref" in
        refs/heads/main) pushing_commits=1; push_sha="$local_sha" ;;  # OK — real commits to check below
        refs/heads/*)
            stray="${remote_ref#refs/heads/}"
            echo ""                                                                      >&2
            echo "BLOCKED: refusing to push branch '$stray' to '$remote_name'."          >&2
            echo ""                                                                      >&2
            echo "Policy: there is only one branch — 'main'. See CLAUDE.md."             >&2
            echo "If you have work on '$stray', merge or rebase it into main and push"   >&2
            echo "main instead. Then delete '$stray' locally:"                           >&2
            echo "  git checkout main && git merge $stray && git branch -d $stray"       >&2
            echo ""                                                                      >&2
            exit 1
            ;;
        refs/tags/*) : ;;  # tag pushes are fine
        *)
            echo ""                                                                      >&2
            echo "BLOCKED: unrecognized ref '$remote_ref' — push aborted for safety."    >&2
            echo ""                                                                      >&2
            exit 1
            ;;
    esac
done <<EOF
$refs
EOF

# ---------- Rule 3: no contact details anywhere in the tree being pushed. ----------
# pre-commit sees only a commit's new lines, so a detail already in the tree, or one
# committed with --no-verify, passes it. This scans every tracked file of the commit
# being pushed for the list's contact entries (emails, address, phone numbers).
# Names are not scanned here: they are allowed in existing prompts and examples.
if [ "${pushing_commits:-0}" = "1" ]; then
    . "$(git rev-parse --show-toplevel)/scripts/git-hooks/forbidden_list.sh"
    load_forbidden
    found=""
    if [ "${#forbidden_contacts[@]}" -gt 0 ]; then
        args=(); for p in "${forbidden_contacts[@]}"; do args+=(-e "$p"); done
        found="$found$(git grep -I -n -i -F "${args[@]}" "$push_sha" -- || true)"$'\n'
    fi
    if [ "${#forbidden_phones[@]}" -gt 0 ]; then
        args=(); for p in "${forbidden_phones[@]}"; do args+=(-e "$p"); done
        found="$found$(git grep -I -n -E "${args[@]}" "$push_sha" -- || true)"
    fi
    if [ -n "$(printf '%s' "$found" | tr -d '[:space:]')" ]; then
        echo ""                                                                          >&2
        echo "BLOCKED: contact details from the forbidden list are in the pushed tree:"  >&2
        # git grep prints <sha>:<path>:<line>:<text>; show path:line only, not the detail.
        printf '%s\n' "$found" | sed '/^$/d' | cut -d: -f2,3 | sort -u | sed 's/^/  /' >&2
        echo ""                                                                          >&2
        echo "origin is the PUBLIC repo. Replace them with placeholders (example.com,"   >&2
        echo "555-01xx), commit, and push again."                                         >&2
        echo "(List: scripts/git-hooks/forbidden_strings.txt — gitignored.)"              >&2
        echo ""                                                                          >&2
        exit 1
    fi
fi

# ---------- Rule 4: regression guard — run the fast security/boot smoke suites. ----------
# Catches the class of silent regression that has bitten this repo (a scope change
# that broke every sub-100 authority scope; fresh-DB / fresh-install boot blockers;
# an imported-but-undeclared dependency). Runs ONLY when pushing real commits to main.
# For a known-safe push (e.g. docs only) skip it with:
#   EMI_SKIP_TESTS=1 git push
if [ "${pushing_commits:-0}" = "1" ] && [ -z "${EMI_SKIP_TESTS:-}" ]; then
    if [ -x ".venv/Scripts/python.exe" ]; then
        PY=".venv/Scripts/python.exe"
    elif [ -x ".venv/bin/python" ]; then
        PY=".venv/bin/python"
    else
        PY=""
        echo "pre-push: .venv interpreter not found — SKIPPING regression guard."        >&2
        echo "          Create the venv (python setup.py) to enable it; push allowed."    >&2
    fi
    if [ -n "$PY" ]; then
        echo "pre-push: running regression guard (set EMI_SKIP_TESTS=1 to skip)…"          >&2
        guard_tests="
app/assistant/tests/non_agent_tests/test_scope_ceiling.py
app/assistant/tests/non_agent_tests/test_scope_per_manager.py
app/assistant/tests/non_agent_tests/test_authority_floor.py
app/assistant/tests/non_agent_tests/test_approval_routing.py
app/assistant/tests/non_agent_tests/test_requirements_completeness.py
app/assistant/tests/non_agent_tests/test_room_resource_loader.py
app/assistant/tests/non_agent_tests/test_tracked_room_scope_yaml.py
app/assistant/tests/non_agent_tests/test_template_scope_yaml.py
app/assistant/tests/non_agent_tests/test_migration_runner.py
app/assistant/tests/non_agent_tests/test_fresh_db_boot.py
app/assistant/tests/non_agent_tests/test_meal_pod_mint_guard.py
app/assistant/tests/non_agent_tests/test_meal_food_beliefs_recency.py
app/assistant/tests/non_agent_tests/test_feedback_extractor_no_phantom.py
app/assistant/tests/non_agent_tests/test_meal_feedback_loop.py
app/assistant/tests/non_agent_tests/test_runtime_injection_timestamps.py
app/assistant/tests/non_agent_tests/test_routine_belief_kind_filter.py
app/assistant/tests/agent_tests/test_no_parent_pathing_in_critical_runtime.py
"
        # $guard_tests is intentionally unquoted: whitespace-split into path args.
        if ! "$PY" -m pytest $guard_tests -q -p no:cacheprovider < /dev/null; then
            echo ""                                                                        >&2
            echo "BLOCKED: regression guard failed — push aborted."                        >&2
            echo "Fix the failing test(s). For a known-safe (e.g. docs-only) push:"        >&2
            echo "  EMI_SKIP_TESTS=1 git push"                                             >&2
            echo ""                                                                        >&2
            exit 1
        fi
        echo "pre-push: regression guard passed."                                          >&2
    fi
fi

exit 0
