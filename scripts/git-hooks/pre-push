#!/usr/bin/env bash
# Hard-block pushes of release-v0.1 to anything that isn't EmiOS-Beta.
#
# Why: EmiOS-Alpha (the legacy private repo at github.com/.../EmiOS-Alpha) and
# EmiOS-Beta (the public Beta release line) coexist as git remotes. Agents
# repeatedly default to "origin" and push release-v0.1 to the wrong repo.
# This hook makes the mistake fatal.
#
# Trigger: any pre-push event. Fails non-zero -> push aborts.
#
# Args (set by git):
#   $1 = remote name (e.g. "origin")
#   $2 = remote URL  (e.g. "https://github.com/.../EmiOS-Beta.git")
# Stdin: one line per ref being pushed:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>

set -eu

remote_name="$1"
remote_url="$2"

# Read stdin into an array — we have to consume it before deciding so git's
# pipe doesn't break, but we ALSO need to forward it to a real push if we
# allow it (we don't — we only validate, then exit 0 to let git proceed).
refs="$(cat)"

# Anything pushing release-v0.1 (as the remote ref) must target EmiOS-Beta.
pushing_release_v01=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${remote_ref:-}" ] && continue
    # Allow deletes — local_sha is all zeros when the ref is being removed.
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    case "$remote_ref" in
        */release-v0.1)
            pushing_release_v01=1
            ;;
    esac
done <<EOF
$refs
EOF

if [ "$pushing_release_v01" -eq 1 ]; then
    case "$remote_url" in
        *EmiOS-Beta*|*emios-beta*)
            : # OK, target is the Beta repo
            ;;
        *)
            echo ""                                                                         >&2
            echo "BLOCKED: push of release-v0.1 to remote '$remote_name' ($remote_url)"     >&2
            echo ""                                                                         >&2
            echo "release-v0.1 is the public Beta line and must only be pushed to the"      >&2
            echo "EmiOS-Beta remote. The remote you targeted does not look like Beta."      >&2
            echo ""                                                                         >&2
            echo "If you really mean to push elsewhere, edit scripts/git-hooks/pre-push"    >&2
            echo "or push from a non-release-v0.1 branch."                                  >&2
            echo ""                                                                         >&2
            exit 1
            ;;
    esac
fi

exit 0
