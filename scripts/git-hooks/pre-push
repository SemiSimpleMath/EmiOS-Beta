#!/usr/bin/env bash
# Hard-enforce the branching policy: only `main` may be pushed, and only to `origin` (EmiOS-Beta).
#
# Why: agents repeatedly create stray branches (release-v0.1, feature/*, etc.)
# and/or push to the wrong remote (alpha-legacy). This hook makes both mistakes fatal.
#
# Trigger: any pre-push event. Fails non-zero -> push aborts.
#
# Args (set by git):
#   $1 = remote name (e.g. "origin")
#   $2 = remote URL  (e.g. "https://github.com/.../EmiOS-Beta.git")
# Stdin: one line per ref being pushed:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>

set -eu

remote_name="$1"
remote_url="$2"

# Read stdin into a buffer — we have to consume it before deciding so git's
# pipe doesn't break.
refs="$(cat)"

# ---------- Rule 1: every push must target `origin` (EmiOS-Beta). ----------
case "$remote_name" in
    origin)
        case "$remote_url" in
            *EmiOS-Beta*|*emios-beta*) : ;; # OK
            *)
                echo ""                                                                  >&2
                echo "BLOCKED: 'origin' does not look like the EmiOS-Beta repo."         >&2
                echo "  remote: $remote_name"                                            >&2
                echo "  url:    $remote_url"                                             >&2
                echo ""                                                                  >&2
                echo "Reset origin to EmiOS-Beta:"                                       >&2
                echo "  git remote set-url origin <EmiOS-Beta URL>"                      >&2
                echo ""                                                                  >&2
                exit 1
                ;;
        esac
        ;;
    *)
        echo ""                                                                          >&2
        echo "BLOCKED: pushes are only allowed to remote 'origin' (EmiOS-Beta)."         >&2
        echo "You targeted '$remote_name' ($remote_url)."                                >&2
        echo ""                                                                          >&2
        echo "If you really need to push to another remote, do it deliberately by"       >&2
        echo "editing scripts/git-hooks/pre-push — and update CLAUDE.md to match."       >&2
        echo ""                                                                          >&2
        exit 1
        ;;
esac

# ---------- Rule 2: only branch `main` may be pushed. ----------
# Allow deletes (local_sha all zeros) so we can clean up stray branches that
# already exist on the remote.
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${remote_ref:-}" ] && continue
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;  # delete is fine
    esac
    case "$remote_ref" in
        refs/heads/main) : ;;  # OK
        refs/heads/*)
            stray="${remote_ref#refs/heads/}"
            echo ""                                                                      >&2
            echo "BLOCKED: refusing to push branch '$stray' to '$remote_name'."          >&2
            echo ""                                                                      >&2
            echo "Policy: there is only one branch — 'main'. See CLAUDE.md."             >&2
            echo "If you have work on '$stray', merge or rebase it into main and push"   >&2
            echo "main instead. Then delete '$stray' locally:"                           >&2
            echo "  git checkout main && git merge $stray && git branch -d $stray"       >&2
            echo ""                                                                      >&2
            exit 1
            ;;
        refs/tags/*) : ;;  # tag pushes are fine
        *)
            echo ""                                                                      >&2
            echo "BLOCKED: unrecognized ref '$remote_ref' — push aborted for safety."    >&2
            echo ""                                                                      >&2
            exit 1
            ;;
    esac
done <<EOF
$refs
EOF

exit 0
