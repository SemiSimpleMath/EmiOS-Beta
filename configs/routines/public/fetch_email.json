{
  "id": "fetch_email",
  "enabled": true,
  "name": "Fetch email",
  "aliases": [
    "email fetch",
    "get email"
  ],
  "runner": "tool",
  "spec": {
    "tool_name": "get_email",
    "arguments": {
      "unseen": true,
      "repo_update": true,
      "all_accounts": true,
      "lookback_hours": 10
    }
  },
  "feature_guard": "email",
  "run_policy": {
    "type": "interval",
    "min_interval_seconds": 300
  },
  "notes": "Periodic email fetch across all active Gmail OAuth accounts. Replaces BackgroundTaskManager round-robin data_fetch."
}
