# EmiAI — Environment Variables
# Copy this file to .env and fill in your values.
# The setup wizard will populate most of these for you automatically.

# ===========================================================================
# LLM PROVIDER — Pick ONE provider; the setup wizard sets these automatically
# ===========================================================================

# Which provider to use as the default (openai | gemini | anthropic)
DEFAULT_LLM_PROVIDER=openai

# Default model for the chosen provider (optional — sensible defaults apply)
# DEFAULT_LLM_MODEL=gpt-4.1-mini

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Google Gemini — free tier available (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# ===========================================================================
# REQUIRED — App will not start without these
# ===========================================================================

# Flask session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-secret

# Same value used for JWT tokens
JWT_SECRET_KEY=change-me-to-a-random-secret

# SQLite database path (relative to repo root, or absolute)
DEV_DATABASE_URI_EMI=sqlite:///emidb.sqlite

# ===========================================================================
# IDENTITY — Who is the primary user and what is the assistant called?
# ===========================================================================

# Your preferred first name (used in prompts and KG)
PRIMARY_USER=YourName

# Name for the AI assistant
ASSISTANT_NAME=Emi

# ===========================================================================
# OPTIONAL — Google APIs (Gmail, Calendar, Tasks, Docs)
# ===========================================================================

# Path to your Google OAuth credentials.json
# Download from: https://console.cloud.google.com/apis/credentials
GOOGLE_CREDENTIALS_PATH=credentials.json

# Fernet encryption key for storing OAuth tokens in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMI_GOOGLE_OAUTH_ENCRYPTION_KEY=

# --- Google Account Routing ---
#
# The app supports multiple named Google accounts (e.g. the primary user's account
# and optionally a dedicated assistant/service account).
#
# Each account is identified by a logical "account_id" string. Tokens are stored
# under that ID in the database and authorised via the in-app OAuth flow at:
#   /oauth/google/start?account_id=<id>
#
# The default account used when no account_id is specified:
EMI_GOOGLE_DEFAULT_ACCOUNT_ID=google_user_primary

# Account used for Gmail reads/sends (defaults to EMI_GOOGLE_DEFAULT_ACCOUNT_ID):
# EMI_GOOGLE_GMAIL_ACCOUNT_ID=google_user_primary

# Account used for Calendar (defaults to EMI_GOOGLE_DEFAULT_ACCOUNT_ID):
# EMI_GOOGLE_CALENDAR_ACCOUNT_ID=google_user_primary

# Account used for Tasks (defaults to EMI_GOOGLE_DEFAULT_ACCOUNT_ID):
# EMI_GOOGLE_TASKS_ACCOUNT_ID=google_user_primary

# Account used for Nest / Smart Device Management (independent from workspace accounts):
# EMI_GOOGLE_NEST_ACCOUNT_ID=google_nest

# --- Multi-account setup ---
# Every account_id you reference here MUST first exist in configs/oauth_accounts.json
# (with its own client_credentials path and scopes); unrecognized values fail loud
# at startup. The default registry ships google_user_primary (workspace) and
# google_nest (smart-home). Add your own entry there before pointing env vars at it.

# ===========================================================================
# OPTIONAL — Smart Home (Nest, Lights)
# ===========================================================================

# Nest thermostat — Google Device Access project ID
# Create at: https://console.nest.google.com/device-access
# Authenticate via the in-app OAuth flow (scope_set=nest) at:
#   /oauth/google/start?account_id=google_nest&scope_set=nest
NEST_PROJECT_ID=

# Bridge bearer tokens — tool-to-bridge authentication (not Google OAuth).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
EMI_SMARTHOME_NEST_TOKEN=
EMI_SMARTHOME_LIGHTS_TOKEN=

# ===========================================================================
# OPTIONAL — Telegram Bot
# ===========================================================================

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Secret token for webhook verification — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Then set the same value when registering the webhook URL with Telegram.
# Required: webhook handler returns 401 if the X-Telegram-Bot-Api-Secret-Token
# header doesn't match.
TELEGRAM_WEBHOOK_SECRET=

# Allowlist of Telegram chat_ids permitted to reach the assistant
# (comma-separated). Fail-closed: if unset, ALL inbound is dropped silently.
# Find your chat_id by messaging the bot once and checking the server log
# (the rejected-inbound warning includes the chat_id). Add it here, restart.
# Example: TELEGRAM_AUTHORIZED_CHAT_IDS=1234567890,9876543210
TELEGRAM_AUTHORIZED_CHAT_IDS=

# ===========================================================================
# OPTIONAL — Apple MusicKit (for Apple Music integration)
# ===========================================================================

MUSICKIT_TEAM_ID=
MUSICKIT_KEY_ID=
MUSICKIT_P8_PATH=musickit/AuthKey_YOURKEYID.p8

# ===========================================================================
# OPTIONAL — Email notifications (for ngrok link emails, etc.)
# ===========================================================================

# Your Gmail address — used as the sender for outgoing email (send_email tool, ngrok notifications)
EMAIL_ADDR=you@gmail.com

# Gmail App Password — generate at https://myaccount.google.com/apppasswords
# Required if using SMTP email sending (send_email tool). Not your regular Gmail password.
GMAIL_APP_PASSWORD=

# Alternative name for the above (either works)
EMAIL_PASSWORD=

# Who to notify for system alerts (defaults to EMAIL_ADDR if unset)
NOTIFY_EMAIL=

# ===========================================================================
# OPTIONAL — Anthropic Claude
# ===========================================================================

ANTHROPIC_API_KEY=

# ===========================================================================
# OPTIONAL — Deployment / SSL
# ===========================================================================

# Set to "production" to enforce HTTPS for OAuth
APP_ENV=development

# Port the app listens on (default: 8000)
PORT=8000

# ===========================================================================
# INTERNAL — Set automatically by the setup wizard (do not edit manually)
# ===========================================================================
SETUP_COMPLETE=false
