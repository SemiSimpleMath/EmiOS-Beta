# EmiAI — Environment Variables
# Copy this file to .env and fill in your values.
# The setup wizard will populate most of these for you automatically.

# ===========================================================================
# LLM PROVIDER — Pick ONE provider; the setup wizard sets these automatically
# ===========================================================================

# ── OpenCode Zen / Go (4th provider option) ───────────────────────────────
# Subscribe at https://opencode.ai/go — a flat-rate plan drawing on a weekly
# quota rather than per-token billing, so exhausting it is a hard stop until
# the window resets, not a bill. Speaks the OpenAI-compatible API with its
# own key and endpoint. Set DEFAULT_LLM_PROVIDER=opencode to make it default.
#
# OPENCODE_API_KEY=sk-...
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
#
# Models: kimi-k2.7-code, deepseek-v4-flash, deepseek-v4-pro, glm-5.2,
#         grok-4.5, qwen3.7-plus, qwen3.7-max, and ~18 more. The current
#         list is whatever GET {OPENCODE_BASE_URL}/models returns.

# ── LLM Provider Selection ─────────────────────────────────────────────────
# Which provider to use as the default (openai | gemini | anthropic | opencode)
# DEFAULT_LLM_PROVIDER=openai

# Default model for the chosen provider (optional — sensible defaults apply)
# DEFAULT_LLM_MODEL=gpt-4.1-mini

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Google Gemini — free tier available (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# --- Web search (Google Custom Search / Programmable Search Engine) ---
# The search_web tool uses Google Custom Search, which needs the Custom Search API
# ENABLED on the key's Cloud project (separate from the Gemini/Generative Language
# API). Recommended: give web search its OWN key here so it has its own quota and a
# blocked search key can't break Gemini. If GOOGLE_SEARCH_API_KEY is unset, search
# falls back to GOOGLE_API_KEY above.
GOOGLE_SEARCH_API_KEY=
# Programmable Search Engine ID (cx) - create at https://programmablesearchengine.google.com
GOOGLE_CSE_ID=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# ===========================================================================
# REQUIRED — App will not start without these
# ===========================================================================

# Flask session secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-secret

# Same value used for JWT tokens
JWT_SECRET_KEY=change-me-to-a-random-secret

# SQLite database path (relative to repo root, or absolute)
DEV_DATABASE_URI_EMI=sqlite:///emidb.sqlite

# ===========================================================================
# IDENTITY — Who is the primary user and what is the assistant called?
# ===========================================================================

# Your preferred first name (used in prompts and KG)
PRIMARY_USER=YourName

# Name for the AI assistant
ASSISTANT_NAME=Emi

# ===========================================================================
# OPTIONAL — Google APIs (Gmail, Calendar, Tasks, Docs)
# ===========================================================================

# Path to your Google OAuth credentials.json
# Download from: https://console.cloud.google.com/apis/credentials
GOOGLE_CREDENTIALS_PATH=credentials.json

# Fernet encryption key for storing OAuth tokens in the database.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMI_GOOGLE_OAUTH_ENCRYPTION_KEY=

# --- Google Account Routing ---
#
# The app supports multiple named Google accounts (e.g. the primary user's account
# and optionally a dedicated assistant/service account).
#
# Each account is identified by a logical "account_id" string. Tokens are stored
# under that ID in the database and authorised via the in-app OAuth flow at:
#   /oauth/google/start?account_id=<id>
#
# The default account used when no account_id is specified:
EMI_GOOGLE_DEFAULT_ACCOUNT_ID=google_user_primary

# Account used for Gmail reads/sends (defaults to EMI_GOOGLE_DEFAULT_ACCOUNT_ID):
# EMI_GOOGLE_GMAIL_ACCOUNT_ID=google_user_primary

# Account used for Calendar (defaults to EMI_GOOGLE_DEFAULT_ACCOUNT_ID):
# EMI_GOOGLE_CALENDAR_ACCOUNT_ID=google_user_primary

# Account used for Tasks (defaults to EMI_GOOGLE_DEFAULT_ACCOUNT_ID):
# EMI_GOOGLE_TASKS_ACCOUNT_ID=google_user_primary

# Account used for Nest / Smart Device Management (independent from workspace accounts):
# EMI_GOOGLE_NEST_ACCOUNT_ID=google_nest

# --- Multi-account setup ---
# Every account_id you reference here MUST first exist in configs/oauth_accounts.json
# (with its own client_credentials path and scopes); unrecognized values fail loud
# at startup. The default registry ships google_user_primary (workspace) and
# google_nest (smart-home). Add your own entry there before pointing env vars at it.

# ===========================================================================
# OPTIONAL — Smart Home (Nest, Lights)
# ===========================================================================

# Nest thermostat — Google Device Access project ID
# Create at: https://console.nest.google.com/device-access
# Authenticate via the in-app OAuth flow (scope_set=nest) at:
#   /oauth/google/start?account_id=google_nest&scope_set=nest
NEST_PROJECT_ID=

# Bridge bearer tokens — tool-to-bridge authentication (not Google OAuth).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
EMI_SMARTHOME_NEST_TOKEN=
EMI_SMARTHOME_LIGHTS_TOKEN=

# ===========================================================================
# OPTIONAL — Telegram Bot
# ===========================================================================

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Secret token for webhook verification — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Then set the same value when registering the webhook URL with Telegram.
# Required: webhook handler returns 401 if the X-Telegram-Bot-Api-Secret-Token
# header doesn't match.
TELEGRAM_WEBHOOK_SECRET=

# Allowlist of Telegram chat_ids permitted to reach the assistant
# (comma-separated). Fail-closed: if unset, ALL inbound is dropped silently.
# Find your chat_id by messaging the bot once and checking the server log
# (the rejected-inbound warning includes the chat_id). Add it here, restart.
# Example: TELEGRAM_AUTHORIZED_CHAT_IDS=1234567890,9876543210
TELEGRAM_AUTHORIZED_CHAT_IDS=

# ===========================================================================
# OPTIONAL — Apple MusicKit (for Apple Music integration)
# ===========================================================================

MUSICKIT_TEAM_ID=
MUSICKIT_KEY_ID=
MUSICKIT_P8_PATH=musickit/AuthKey_YOURKEYID.p8

# ===========================================================================
# OPTIONAL — Email notifications (for ngrok link emails, etc.)
# ===========================================================================

# Your Gmail address — used as the sender for outgoing email (send_email tool, ngrok notifications)
EMAIL_ADDR=you@gmail.com

# Gmail App Password — generate at https://myaccount.google.com/apppasswords
# Required if using SMTP email sending (send_email tool). Not your regular Gmail password.
GMAIL_APP_PASSWORD=

# Alternative name for the above (either works)
EMAIL_PASSWORD=

# Who to notify for system alerts (defaults to EMAIL_ADDR if unset)
NOTIFY_EMAIL=

# ===========================================================================
# OPTIONAL — Deployment / SSL
# ===========================================================================

# Set to "production" to enforce HTTPS for OAuth
APP_ENV=development

# Port the app listens on (default: 8000)
PORT=8000

# ===========================================================================
# OPTIONAL — Paths (packaged / container deployments)
# ===========================================================================
# EmiOS splits its READ-ONLY code layer from a WRITABLE data layer. In a dev
# checkout they are the same directory and none of this needs setting; in a
# packaged or containerized install, EMI_DATA_DIR is the whole contract.
#
# Set EMI_DATA_DIR and everything below it follows automatically:
#   <EMI_DATA_DIR>/.env        the live env file that run_flask.py loads
#   <EMI_DATA_DIR>/configs     routines.json, subsystems.yaml, sleep_tracking.yaml
#   <EMI_DATA_DIR>/resources   the live personal resources (seeded from .example)
#   <EMI_DATA_DIR>/uploads     transient tool artifacts
#   <EMI_DATA_DIR>/chroma_db   KG vector store
# EMI_DATA_DIR=/data

# Individual overrides, each winning over the EMI_DATA_DIR-derived default.
# Only needed to place one directory somewhere else.
# EMI_CONFIGS_DIR=
# EMI_RESOURCES_DIR=
# EMI_UPLOADS_DIR=
# EMI_CHROMA_KG_DB_DIR=
# EMI_ENV_FILE=

# Code-layer roots. Normally auto-detected; set only if detection fails.
# EMI_ROOT=
# EMI_APP_ROOT=

# ===========================================================================
# OPTIONAL — Serving and reverse proxies
# ===========================================================================
# Bind address (default 0.0.0.0). The packaged launcher sets 127.0.0.1 so the
# installed app is not reachable from the network.
# EMI_HOST=0.0.0.0

# Listen port (default 8000).
# EMI_PORT=8000

# Serve EmiOS under a subpath, e.g. https://host/emi/. Flask generates URLs
# with this prefix. Leave unset to serve at the root.
# EMI_PROXY_SUBPATH=/emi

# Number of proxy hops to trust for X-Forwarded-* (Werkzeug ProxyFix).
# Defaults to 1 when EMI_PROXY_SUBPATH is set, else 0.
#
# This decides whether attacker-controllable headers are believed, so set it to
# the ACTUAL number of proxies in front of the app — no higher. A malformed
# value refuses to boot rather than guessing. Trusting a hop that does not
# exist lets a client forge its own X-Forwarded-For.
#
# It does not make direct access safe on its own: bind to localhost or firewall
# the port so the proxy is the only route in.
# EMI_TRUST_PROXY_HEADERS=1

# Externally reachable base URL, used to build OAuth redirect URIs.
# EMI_WEB_BASE_URL wins; EMI_BASE_URL is the fallback; default
# http://127.0.0.1:8000. Set one of these if OAuth callbacks land on the wrong
# host behind a proxy.
# EMI_WEB_BASE_URL=https://emi.example.com
# EMI_BASE_URL=

# ===========================================================================
# OPTIONAL — Slack interface
# ===========================================================================
# Required to verify X-Slack-Signature on inbound webhooks. Without it,
# signature verification cannot run.
SLACK_SIGNING_SECRET=

# Comma-separated allowlists. BOTH are FAIL-CLOSED: if unset, every inbound
# Slack event is rejected, exactly like TELEGRAM_AUTHORIZED_CHAT_IDS above.
SLACK_AUTHORIZED_TEAM_IDS=
SLACK_AUTHORIZED_CHANNELS=

# ===========================================================================
# OPTIONAL — Twilio SMS interface
# ===========================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Comma-separated allowlist of sender numbers.
TWILIO_AUTHORIZED_NUMBERS=

# Maps inbound Twilio numbers to rooms.
TWILIO_NUMBER_ROOM_MAP=

# Skip Twilio signature verification for localhost requests. DEVELOPMENT ONLY —
# it disables authentication of inbound SMS webhooks. Leave unset in production.
# EMI_TWILIO_SKIP_SIG_LOCALHOST=

# ===========================================================================
# OPTIONAL — Misc runtime
# ===========================================================================
# IANA timezone, e.g. America/Los_Angeles. The setup wizard writes this.
TIMEZONE=

# Local-time hour that starts a new "day" for dayflow and daily rollups
# (0-23, default 5). Out-of-range values fall back to 5.
# DAY_RESET_HOUR=5

# OpenWeatherMap key for the weather tool. Optional — without it the tool
# falls back to Open-Meteo, which needs no key.
OPENWEATHER_API_KEY=

# ===========================================================================
# INTERNAL — Set automatically by the setup wizard (do not edit manually)
# ===========================================================================
SETUP_COMPLETE=false
