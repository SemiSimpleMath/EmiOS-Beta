{
  "doc": "Unified registry of the assistant's own accounts across platforms. Handles come from EMI_OWN_* env vars at read time (kept out of git); auth tokens live in either the OAuth registry (configs/oauth_accounts.json) for Google or auth.* pods for everything else. Subsystems (subconscious, send_email, future bluesky_post / x_post / reddit_post tools) read this resource to know 'which identity am I acting as on platform X.' The /emi-accounts admin UI uses auth.env_ref + auth.secret_label to drive its configure-modal — each pod_ref account declares which env var the raw secret lives in and what to call it in the UI prompt. This .example ships as a sanitized template; the real resource_emi_accounts.json is gitignored and seeded from it on first run.",
  "schema_version": 1,
  "accounts": [
    {
      "id": "emi_gmail_primary",
      "platform": "gmail",
      "display_name": "Assistant Gmail",
      "handle_env": "EMI_OWN_GMAIL_HANDLE",
      "accessible_by": ["emi"],
      "status": "not_configured",
      "auth": {
        "kind": "google_oauth",
        "account_id": "emi_google_primary"
      },
      "notes": "Complete consent at /oauth/google/start?account_id=emi_google_primary signing in as the assistant's own Gmail. Once configured, send_email supports from_account='emi' end-to-end."
    },
    {
      "id": "emi_bluesky_primary",
      "platform": "bluesky",
      "display_name": "Assistant on Bluesky",
      "handle_env": "EMI_OWN_BLUESKY_HANDLE",
      "accessible_by": ["emi"],
      "status": "not_configured",
      "auth": {
        "kind": "pod_ref",
        "pod_kind": "auth.bearer",
        "pod_id_env": "EMI_OWN_BLUESKY_AUTH_POD_ID",
        "env_ref": "EMI_POD_BLUESKY_APP_PASSWORD",
        "secret_label": "App password",
        "secret_hint": "Generate at Bluesky Settings → Privacy and Security → App Passwords. Looks like abcd-efgh-ijkl-mnop.",
        "pod_label": "Bluesky app password",
        "validator": "bluesky"
      },
      "notes": "AT Protocol. App password stashed in an auth.bearer pod (env_ref EMI_POD_BLUESKY_APP_PASSWORD). Wired via http_request + skills/bluesky/SKILL.md — two-step createSession then Bearer for any operation."
    },
    {
      "id": "emi_twitter_primary",
      "platform": "twitter",
      "display_name": "Assistant on X",
      "handle_env": "EMI_OWN_TWITTER_HANDLE",
      "accessible_by": ["emi"],
      "status": "not_configured",
      "auth": {
        "kind": "pod_ref",
        "pod_kind": "auth.bearer",
        "pod_id_env": "EMI_OWN_TWITTER_AUTH_POD_ID",
        "env_ref": "EMI_POD_TWITTER_BEARER",
        "secret_label": "Bearer token",
        "secret_hint": "Generate at developer.x.com under your project's app keys. Paid tier required for write.",
        "pod_label": "X (Twitter) bearer token"
      },
      "notes": "Paid API tier required for write."
    },
    {
      "id": "emi_reddit_primary",
      "platform": "reddit",
      "display_name": "Assistant on Reddit",
      "handle_env": "EMI_OWN_REDDIT_USERNAME",
      "accessible_by": ["emi"],
      "status": "not_configured",
      "auth": {
        "kind": "pod_ref",
        "pod_kind": "auth.bearer",
        "pod_id_env": "EMI_OWN_REDDIT_AUTH_POD_ID",
        "env_ref": "EMI_POD_REDDIT_TOKEN",
        "secret_label": "OAuth token",
        "secret_hint": "Create a script-type app at reddit.com/prefs/apps; use the OAuth token, not the secret.",
        "pod_label": "Reddit OAuth token"
      },
      "notes": "OAuth app + per-subreddit posting rules."
    },
    {
      "id": "emi_telegram_primary",
      "platform": "telegram",
      "display_name": "Assistant on Telegram",
      "handle_env": "EMI_OWN_TELEGRAM_HANDLE",
      "accessible_by": ["emi"],
      "status": "not_configured",
      "auth": {
        "kind": "pod_ref",
        "pod_kind": "auth.bearer",
        "pod_id_env": "EMI_OWN_TELEGRAM_AUTH_POD_ID",
        "env_ref": "EMI_POD_TELEGRAM_BOT_TOKEN",
        "secret_label": "Bot token",
        "secret_hint": "Talk to @BotFather on Telegram; create a new bot; copy the HTTP API token.",
        "pod_label": "Telegram bot token"
      },
      "notes": "A dedicated bot account lets the assistant DM/post on its own behalf rather than routing through the owner's transport bot."
    }
  ]
}
