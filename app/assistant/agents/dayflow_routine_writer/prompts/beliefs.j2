{% for belief in beliefs %}
- [belief:{{ belief.belief_key }}]{% if belief.get('cluster') %} (topic: {{ belief.cluster }}){% endif %}
  {{ belief.statement }}
{%- if belief.conditions %}
  conditions: {{ belief.conditions | tojson }}
{%- endif %}
{%- if belief.first_observed or belief.last_confirmed %}
  {% if belief.first_observed %}first seen {{ belief.first_observed }}{% endif %}{% if belief.first_observed and belief.last_confirmed %}; {% endif %}{% if belief.last_confirmed %}last confirmed {{ belief.last_confirmed }}{% endif %}
{%- endif %}
{%- if belief.get('related') %}
  read with these related beliefs (they are not entries):
{%- for r in belief.related %}
    - [belief:{{ r.belief_key }}] {{ r.statement }}
{%- endfor %}
{%- endif %}
{%- if belief.get('earlier') %}
  placed earlier today:
{%- for p in belief.earlier %}
    - {{ p.time }}{% if p.until %} until {{ p.until }}{% endif %}: {{ p.outcome }}
{%- endfor %}
{%- endif %}
{% else %}
(no beliefs approved for the calendar)
{% endfor %}
