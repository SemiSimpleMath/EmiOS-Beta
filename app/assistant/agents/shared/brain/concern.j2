{#- One concern's record, as the brain reads it (docs/design/concerns_as_state_2026-10-09.md, rule 1). Expects `c`
    (brain_step._concern_view). Where agent_input.source_labels labels a ref, the label is shown in its place. -#}
{%- set L = (agent_input.get("source_labels") if agent_input is defined else none) or {} -%}
### [{{ c.label }}] {{ c.title }} ({{ c.status }})
- about: {{ c.subject }}; kind: {{ c.kind }}; severity: {{ c.severity }}; horizon: {{ c.horizon }}
{% if c.source %}- raised from: {{ c.source }}
{% endif -%}
- done when: {{ c.done_when or "(not stated)" }}
{% if c.expires %}- no longer matters after: {{ c.expires }}
{% endif -%}
- first observed: {{ c.first_observed | local_time }}

{% for w in c.attached_work -%}
- work attached {{ w.attached_at | local_time }}: {{ L.get(w.work_id, w.work_id) }}: {{ w.objective }}
{% with p = w.progress, pad = "  " %}{% include 'shared/work/work_progress.j2' %}{% endwith -%}
{% for j in w.judgments -%}
{% if loop.first %}{{ "  " }}Judgments of its steps:
{% endif %}{{ "  " }}- task "{{ j.title }}" ({{ j.at | local_time }}): {{ j.outcome }}
{% for r in j.replies -%}
{{ "    " }}- {{ r }}
{% endfor -%}
{% endfor -%}
{% endfor -%}
{% if c.history %}- its record, oldest first (a summary of the older notes, then every note since, each with when it was
  written):
{{ c.history }}
{% endif %}
