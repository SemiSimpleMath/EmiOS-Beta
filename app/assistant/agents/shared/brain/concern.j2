{#- One concern's full record, as the brain and the brief writer read it. Expects `c` (brain_step._concern_view). -#}
### [{{ c.label }}] {{ c.title }} ({{ c.status }})
- about: {{ c.subject }}; kind: {{ c.kind }}; severity: {{ c.severity }}; horizon: {{ c.horizon }}
{% if c.owner_words %}- the owner asked for this: "{{ c.owner_words }}"
{% endif -%}
- done when: {{ c.done_when or "(not stated)" }}
- first observed: {{ c.first_observed }}
- notes: {{ c.notes }}
{% for e in c.evidence -%}
- evidence ({{ e.kind }} {{ e.ref }}){% if e.snippet %}: {{ e.snippet }}{% endif %}
{% endfor -%}
{% for w in c.attached_work -%}
- work attached {{ w.attached_at }}: {{ w.work_id }} ({{ w.status }}): {{ w.objective }}
{% for j in w.judgments -%}
{{ "  " }}- task "{{ j.title }}" judged {{ j.verdict }} ({{ j.at }}), next step {{ j.next_step or "none" }}: {{ j.outcome }}
{% for r in j.replies -%}
{{ "    " }}- {{ r }}
{% endfor -%}
{% endfor -%}
{% if w.ended %}{{ "  " }}- ended {{ w.ended.outcome }} ({{ w.ended.at }}){% if w.ended.reason %}: {{ w.ended.reason }}{% endif %}
{% endif -%}
{% endfor -%}
{% if c.journal %}- journal:{{ c.journal }}
{% endif %}
