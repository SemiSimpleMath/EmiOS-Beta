{#- One concern's full record, as the brain and the brief writer read it. Expects `c` (brain_step._concern_view).
    Where agent_input.source_labels labels a ref (the brief writer), the label is shown in its place. -#}
{%- set L = (agent_input.get("source_labels") if agent_input is defined else none) or {} -%}
### [{{ c.label }}] {{ c.title }} ({{ c.status }})
- about: {{ c.subject }}; kind: {{ c.kind }}; severity: {{ c.severity }}; horizon: {{ c.horizon }}
{% if c.owner_words %}- the owner asked for this: "{{ c.owner_words }}"
{% endif -%}
- done when: {{ c.done_when or "(not stated)" }}
- first observed: {{ c.first_observed }}
{% for e in c.evidence -%}
- evidence ({{ e.kind }} {{ L.get(e.ref, e.ref) }}){% if e.snippet %}: {{ e.snippet }}{% endif %}
{% endfor -%}
{% for w in c.attached_work -%}
- work attached {{ w.attached_at | local_time }}: {{ L.get(w.work_id, w.work_id) }}: {{ w.objective }}
{% with p = w.progress, pad = "  " %}{% include 'shared/work/work_progress.j2' %}{% endwith -%}
{% for j in w.judgments -%}
{% if loop.first %}{{ "  " }}Judgments of its steps:
{% endif %}{{ "  " }}- task "{{ j.title }}" ({{ j.at | local_time }}): {{ j.outcome }}
{% for r in j.replies -%}
{{ "    " }}- {{ r }}
{% endfor -%}
{% endfor -%}
{% endfor -%}
{% if c.history %}- notes and journal, oldest first, each with when it was written:
{{ c.history }}
{% endif %}
