{#- People, places and things named here, from the knowledge graph (subconscious/kg_links.py), each
    with its ties to the household's people; what joins them; the facts closest in meaning.
    Expects `agent_input` with entities and shared, and optionally facts. -#}
## Named here, from the knowledge graph

{% for e in agent_input.entities -%}
- {{ e.label }}: {{ e.description or "(no description recorded)" }}
{% for t in e.get("ties") or [] %}  - {{ t }}
{% endfor -%}
{% else -%}
(no person, place or thing in the knowledge graph is named here)
{% endfor %}
{% if agent_input.shared and (agent_input.shared.links or agent_input.shared.entities) -%}
What joins them in the knowledge graph (recorded before today):
{% for l in agent_input.shared.links -%}
- {{ l.type }} "{{ l.label }}"{% if l.start %} ({{ l.start }}{% if l.end and l.end != l.start %} to {{ l.end }}{% endif %}){% endif %}: {{ l.description or "(no description)" }}
{% endfor -%}
{% for s in agent_input.shared.entities -%}
- connected to both: {{ s.label }}: {{ s.description or "(no description)" }}
{% endfor %}
{% endif %}
{% if agent_input.get("facts") %}
## From the knowledge graph, closest in meaning (it may say whose school, club or account this is)

{% for f in agent_input.facts -%}
- {{ f.sentence }}
{% endfor %}
{% endif %}
