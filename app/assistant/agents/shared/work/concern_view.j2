{#- The concerns a work object serves, each with its record. Expects `concerns` (concern_view.view). -#}
{% for c in concerns %}
{% if c.get('unresolved') %}- concern {{ c.ref }}: not found ({{ c.unresolved }})
{% else %}- concern {{ c.concern_id[:8] }}: {{ c.title }} [{{ c.status }}]
{% if c.get('severity') %}  severity: {{ c.severity }} (how much it matters to the household, as the brain judged it)
{% endif %}  done when: {{ c.done_when or "(not stated)" }}
{% if c.source %}  raised from: {{ c.source }}
{% endif %}{% if c.expires %}  no longer matters after: {{ c.expires }}
{% endif %}{% if c.history %}  its record, oldest first (a summary of the older notes, then every note since, each with when it was written):
{{ c.history | indent(4, true) }}
{% endif %}{% if c.get('plan') and c.plan.todo %}  things that should be done:
{% for t in c.plan.todo %}    - {{ t }}
{% endfor %}{% endif %}{% for w in c.get('attempts') or [] %}{% if loop.first %}  work on this concern so far:
{% endif %}    - {{ w.objective }} ({{ w.work_id }}; attached {{ w.attached_at | local_time }})
{% with p = w.progress, pad = "      " %}{% include 'shared/work/work_progress.j2' %}{% endwith %}{% for j in w.judgments %}{% if loop.first %}      judgments of its steps:
{% endif %}      - task "{{ j.title }}" ({{ j.at | local_time }}): {{ j.outcome }}
{% for r in j.replies %}        - {{ r }}
{% endfor %}{% endfor %}{% endfor %}{% endif %}{% endfor %}
