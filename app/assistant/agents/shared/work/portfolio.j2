{%- set L = labels | default({}) -%}
{%- set terse = wording_explained is defined and wording_explained -%}
=== WORK OBJECT {{ L.get(work.id, work.id) }} ===
goal: {{ work.objective }}
status: {{ work.status }} | progress: {{ work.completed }}/{{ work.tasks|length }} top-level tasks complete
{% if work.success_criteria %}success criteria: {{ work.success_criteria }}
{% endif %}{% if not terse or work.failure_count %}goal failures judged by finalizer: {{ work.failure_count }}
{% endif %}{% if not terse %}Historical failure totals do not request another user decision. Follow current finalizer instructions and the user's recorded answers; do not re-ask a resolved question because of this tally.
{% endif %}{% if work.pending_replan %}PENDING ARCHITECT REVISION: apply the finalizer instruction before further dispatch.
{% endif %}{% if work.unrun %}STILL UNRUN ({{ work.unrun }}){% if not terse %}: completing this work object would DISCARD these outstanding tasks{% endif %}.
{% endif %}
{% include 'shared/work/execution_state.j2' %}
SOURCE CONTEXT
{% with sources = work.sources | default([]), compact_sources = true %}{% include 'shared/work/source_context.j2' %}{% endwith %}
{% if work.concerns | default([]) %}CONCERN THIS WORK SERVES (the brain's record of it)
{% for c in work.concerns %}{% if c.get('concern_id') and c.concern_id in L %}- [{{ L[c.concern_id] }}] {{ c.title }}: its record is under THE CONCERNS THE WORK SERVES
{% else %}{% with concerns = [c] %}{% include 'shared/work/concern_view.j2' %}{% endwith %}{% endif %}{% endfor %}
{% endif %}
TASKS (main assignments only)
{% for task in work.tasks %}
- [{{ task.status }}] {{ L.get(task.id, task.id) }} | {{ task.title }}
  GOAL: {{ task.directive }}
{% if not terse or task.epoch or task.failure_count %}  dispatch attempt: {{ task.epoch }} | finalizer failure count: {{ task.failure_count }}
{% endif %}{% if task.awaiting_judgment %}  AWAITING JUDGMENT: result exists; completion has not been accepted.
{% endif %}{% if task.dependencies %}  DEPENDS ON: {% for dep in task.dependencies %}{{ L.get(dep.id, dep.id) }} [{{ dep.status }}; {% if dep.satisfied %}satisfied{% else %}BLOCKED{% endif %}]{% if not loop.last %}, {% endif %}{% endfor %}
{% endif %}{% if task.wake_kind %}  WAIT: {{ task.wake_kind }}{% if task.wake_at %} | {{ task.wake_at }}{% endif %}{% if task.wake_ref %} | {{ task.wake_ref }}{% endif %}
{% endif %}{% with watch = task.watch %}{% include 'shared/work/watch.j2' %}{% endwith %}{% if task.terminal %}  REASON: {{ task.terminal.get('reason', '') }}
{% endif %}{% if task.finalizer or task.awaiting_judgment %}{% set finalizer = task.finalizer %}{% include 'shared/work/finalizer_summary.j2' %}{% endif %}
{% endfor %}
{% if work.actions %}ACTIONS TAKEN ({{ work.actions|length }}) — already performed; do not repeat without justification
{% for action in work.actions %}- {{ action.when }} | {{ action.channel }} -> {{ action.target }} [{{ action.outcome }}] {{ action.summary }}
{% endfor %}{% endif %}{% for contact in work.repeated_contacts %}WARNING: {{ contact.count }} separate {{ contact.channel }} messages to {{ contact.target }} on this goal alone. Asking again is very unlikely to be the missing step.
{% endfor %}
