{#
  Shared macros for rendering dayflow items consistently across all agents.

  Usage in any agent user.j2:
    {% from "shared/macros/dayflow_items.j2" import task_line, task_block %}

  task_line(meta)  — single item, one line + detail lines
  task_block(items, title, [limit-ignored]) — grouped section with
    header; renders EVERY item. The `limit` argument is accepted
    only for backwards compat with existing call sites; it is now
    ignored. Decision/auditor agents must see the full state so
    runaway is visible — drop arguments at next sweep.
#}


{% macro task_line(meta) -%}
- task: {{ meta.get("short_id", "") }}
  {%- if meta.get("plan_id") %} | plan: {{ meta.get("plan_id") }}{% endif %}
  {%- if meta.get("state") %} | {{ meta.get("state") }}{% endif %}
  {%- if meta.get("source_type") %} | {{ meta.get("source_type") }}{% endif %}
  {%- if meta.get("created_at_local") %} | created: {{ meta.get("created_at_local") }}{% endif %}
  {%- if meta.get("dispatched_at_local") or meta.get("dispatched_at") %} | dispatched: {{ meta.get("dispatched_at_local", meta.get("dispatched_at","")) }}{% endif %}
  {%- if meta.get("age_hours") %} | age: {{ meta.get("age_hours") }}{% endif %}
  {{ meta.get("summary", "") }}
  {#- The pod holding the FULL content, when there is one. `task:` above is a short_id,
      which is a prompt label: no tool accepts it and it is not unique (2026-09-13: 7667
      named both a school newsletter and an unrelated June chat). A pod id is the canonical
      handle and pod_fetch opens it, so an agent that needs the body has a door rather than
      a number. Omitted entirely when absent — a handle that does not resolve is worse than
      none, which is the whole lesson here. #}
  {%- if meta.get("pod_id") %}
  full content: {{ meta.get("pod_id") }}  (open with pod_fetch)
  {%- endif %}
  {%- if meta.get("execution_result") %}
  result: {{ meta.get("execution_result") }}
  {%- endif %}
  {%- if meta.get("ticket_response") %}
  ticket_response: {{ meta.get("ticket_response") }}
  {%- endif %}
  {%- if meta.get("wait_reason") %}
  wait: {{ meta.get("wait_reason") }}
  {%- endif %}
  {%- if meta.get("reactivate_at_local") or meta.get("reactivate_at_utc") %}
  reactivate: {{ meta.get("reactivate_at_local", meta.get("reactivate_at_utc","")) }}
  {%- endif %}
  {%- if meta.get("state_reason") %}
  reason: {{ meta.get("state_reason") }}
  {%- endif %}
  {%- if meta.get("dispatch_status") %}
  dispatch_status: {{ meta.get("dispatch_status") }}
  {%- endif %}
{%- endmacro %}


{% macro task_block(items, title, limit=None) -%}
{% if items %}
+++++ {{ title }} +++++
{% for ex in items %}
{% set meta = ex.get("metadata", {}) %}
{{ task_line(meta) }}
{% endfor %}
{% endif %}
{%- endmacro %}


{# plan_task_line: for plan_task_status flat dicts (task_id, summary, state, etc.) #}
{% macro plan_task_line(t) -%}
- task: {{ t.get("task_id","") }}
  {%- if t.get("state") %} | {{ t.get("state") }}{% endif %}
  {%- if t.get("dispatched_at") %} | dispatched: {{ t.get("dispatched_at") }}{% endif %}
  {{ t.get("summary","") }}
  {%- if t.get("execution_result") %}
  result: {{ t.get("execution_result") }}
  {%- endif %}
  {%- if t.get("ticket_response") %}
  ticket_response: {{ t.get("ticket_response") }}
  {%- endif %}
  {%- if t.get("state") == "waiting" %}
  {%- if t.get("wait_reason") %}
  waiting for: {{ t.get("wait_reason") }}
  {%- endif %}
  {%- if t.get("reactivate_at_local") or t.get("reactivate_at") %}
  reactivate: {{ t.get("reactivate_at_local", t.get("reactivate_at","")) }}
  {%- endif %}
  {%- endif %}
{%- endmacro %}
