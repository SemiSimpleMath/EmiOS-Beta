########## TRACKED ITEMS ##########
{%- if active_dayflow_items %}
{%- set needs_placement = [] %}
{%- set actionable = [] %}
{%- set dispatched = [] %}
{%- set waiting = [] %}
{%- set completed = [] %}
{%- for ex in active_dayflow_items %}
{%- set m = ex.get("metadata", {}) %}
{%- if m.get("state","") == "important_open" %}{% if needs_placement.append(ex) %}{% endif %}
{%- elif m.get("state","") == "actionable" %}{% if actionable.append(ex) %}{% endif %}
{%- elif m.get("state","") == "dispatched" %}{% if dispatched.append(ex) %}{% endif %}
{%- elif m.get("state","") in ["waiting", "watching"] %}{% if waiting.append(ex) %}{% endif %}
{%- elif m.get("state","") == "closed" %}{% if completed.append(ex) %}{% endif %}
{%- endif %}
{%- endfor %}

{{ task_block(needs_placement, "Needs Placement (decide: actionable, waiting, or watching)") }}
{{ task_block(waiting, "Waiting Tasks (check if conditions are now met)") }}
{%- endif %}
