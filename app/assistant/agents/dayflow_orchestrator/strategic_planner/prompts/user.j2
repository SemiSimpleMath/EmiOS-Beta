{%- set has_responses = recent_responded_tickets.get("accepted") or recent_responded_tickets.get("declined") or recent_responded_tickets.get("snoozed") %}
{%- if has_responses %}

########## TICKET RESPONSES (user directives — obey these) ##########
{%- for category, label in [("accepted", "ACCEPTED"), ("declined", "DECLINED"), ("snoozed", "SNOOZED")] %}
{%- if recent_responded_tickets.get(category) %}
{%- for t in recent_responded_tickets.get(category)[:10] %}
- [{{ t.get("responded_at_local","") }}] {{ label }}: {{ t.get("title","") }}
  {{ t.get("message","") }}{% if t.get("user_comment") %}
  user: "{{ t.get("user_comment") }}"{% endif %}{% if t.get("source_task_ids") %}
  tasks: {{ t.get("source_task_ids")|join(", ") }}{% endif %}{% if label == "SNOOZED" and t.get("snooze_until_local") %}
  until: {{ t.get("snooze_until_local") }}{% endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endif %}

