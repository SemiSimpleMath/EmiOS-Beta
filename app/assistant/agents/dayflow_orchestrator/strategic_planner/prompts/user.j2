*Background awareness — not today's urgent work. Use these to anticipate (e.g. start prep N days ahead), but don't create immediate plan_tasks unless evidence shows the horizon is collapsing.*
{%- for c in _subc.active_concerns_longer_horizon %}
- [{{ c.severity }}/{{ c.horizon }}] {{ c.title }} ({{ c.subject }})
  notes: {{ c.notes }}
{%- endfor %}
{%- endif %}
