########## NEW ARTIFACTS (triage admitted — review for planning) ##########
{%- set all_artifacts = [] %}
{%- set seen_art_ids = [] %}
{%- for m in (admitted_artifacts or []) %}
{%- set meta = m.get("metadata", {}) %}
{%- if meta.get("state","") in ["artifact", "needs_planning", "new"] and meta.get("item_id","") not in seen_art_ids %}{% if all_artifacts.append(m) %}{% endif %}{% if seen_art_ids.append(meta.get("item_id","")) %}{% endif %}{% endif %}
{%- endfor %}
{%- for ex in (active_dayflow_items or []) %}
{%- set meta = ex.get("metadata", {}) %}
{%- if meta.get("state","") in ["artifact", "needs_planning", "new"] and not meta.get("plan_id") and meta.get("item_id","") not in seen_art_ids %}{% if all_artifacts.append(ex) %}{% endif %}{% endif %}
{%- endfor %}
{%- if all_artifacts %}
{%- for m in all_artifacts %}
{%- set meta = m.get("metadata", {}) %}
{%- if meta.get("source_type","") == "email" %}
- Email{% if meta.get("created_at_local") %} received {{ meta.get("created_at_local") }}{% endif %} from {{ meta.get("email_sender","Unknown") }}: "{{ meta.get("email_subject", meta.get("summary","")) }}"{% if meta.get("email_summary") %} — {{ meta.get("email_summary") }}{% endif %}{% if meta.get("importance","") not in ["medium", ""] %} — {{ meta.get("importance") }}{% endif %}
  artifact_id: {{ meta.get("short_id", meta.get("item_id","")) }}
  {#- Render the verbatim body excerpt below the paraphrased summary so the
      planner sees the actual specifics (dates, times, names, numbers) the
      summary may have compressed away. Bug 2026-05-25: Katy's email listed
      every period-specific finals time in the body but the email_summary
      paraphrased them as "with period-specific times", and the planner
      kept re-asking for what was already provided.
      TODO: mint a pod for the full body so the planner can pod_fetch when
      the excerpt is truncated (excerpt is ~1.5K chars today; long emails
      lose data past that cutoff). #}
{%- if meta.get("email_body_excerpt") %}
  body:
    {{ meta.get("email_body_excerpt") | replace("\n", "\n    ") }}
{%- endif %}
{%- else %}
- {{ meta.get("summary","(no summary)") }}{% if meta.get("importance","") not in ["medium", ""] %} — {{ meta.get("importance") }}{% endif %} ({{ meta.get("source_type","") }})
  artifact_id: {{ meta.get("short_id", meta.get("item_id","")) }}
{%- endif %}
{%- if meta.get("enrichment") %}
  **Context:** {{ meta.get("enrichment") }}
{%- endif %}
{%- endfor %}
{%- else %}
None
{%- endif %}

{%- set active_plans = [] %}
{%- set closed_plans = [] %}
{%- for plan in (plan_task_status or []) %}
{%- set has_open = [] %}
{%- for t in plan.get("remaining_tasks", []) %}{% if has_open.append(1) %}{% endif %}{% endfor %}
{%- if plan.get("plan_state","active") in ["closed", "suppressed"] and not has_open %}{% if closed_plans.append(plan) %}{% endif %}
{%- else %}{% if active_plans.append(plan) %}{% endif %}
{%- endif %}
{%- endfor %}

########## CURRENT PLANS ##########
{%- if active_plans %}
{%- for plan in active_plans %}
##### [{{ plan.get("plan_id","") }}]
{{ plan.get("synopsis","") }}
{%- set all_tasks = plan.get("completed_tasks", []) + plan.get("remaining_tasks", []) %}
{%- if all_tasks %}
{%- for t in all_tasks %}
{{ plan_task_line(t) }}
{%- endfor %}
{%- else %}
No tasks. Close this plan if objective is complete, or add tasks if not.
{%- endif %}
{% endfor %}
{%- else %}
No active plans.
{%- endif %}

{%- set non_plan_open = [] %}
{%- set non_plan_closed = [] %}
{%- set pending_directives = [] %}
{%- for ex in (active_dayflow_items or []) %}
{%- set m = ex.get("metadata", {}) %}
{%- if m.get("state","") == "pending_directive" %}{% if pending_directives.append(ex) %}{% endif %}
{%- elif not m.get("plan_id") %}
{%- if m.get("state","") in ["important_open", "actionable", "dispatched", "waiting", "watching"] %}{% if non_plan_open.append(ex) %}{% endif %}
{%- elif m.get("state","") in ["closed"] %}{% if non_plan_closed.append(ex) %}{% endif %}
{%- endif %}
{%- endif %}
{%- endfor %}

{%- if pending_directives %}

########## PENDING USER DIRECTIVES (act on these) ##########
*The user added a follow-up instruction to a ticket reply. The original artifact stays alive here so you have the full context. Plan an action that fulfills the directive (most often: dispatch a tool). Close the item via acted_on_item_ids when the action lands.*
{%- for ex in pending_directives %}
{%- set m = ex.get("metadata", {}) %}
- artifact: {{ m.get("summary","(no summary)") }}{% if m.get("source_type","") %} ({{ m.get("source_type") }}){% endif %}
  artifact_id: {{ m.get("short_id", m.get("item_id","")) }}
  user directive: "{{ m.get("directive_text","") }}"{% if m.get("directive_source_ticket_id") %}
  source ticket: {{ m.get("directive_source_ticket_id") }}{% endif %}
{%- if m.get("source_type","") == "email" %}
  email: from {{ m.get("email_sender","Unknown") }} — "{{ m.get("email_subject","") }}"
  {#- Prefer the verbatim body excerpt over the summary; same reasoning as
      the artifact list above (paraphrase loses dates/times/specifics). #}
  body: {{ m.get("email_body_excerpt", m.get("email_summary","")) }}
{%- endif %}
{%- if m.get("enrichment") %}
  context: {{ m.get("enrichment") }}
{%- endif %}
{%- endfor %}
{%- endif %}

