- [{{ t.get("suggestion_type","") }}] {{ t.get("title","") }}
  {{ t.get("message","") }}{% if t.get("snooze_until_local","") %}
  snoozed until {{ t.get("snooze_until_local") }}{% endif %}{% if t.get("source_task_ids") %}
  tasks: {{ t.get("source_task_ids")|join(", ") }}{% endif %}
{%- endfor %}
{%- endif %}

