{#- The day's tasks input (subconscious/day_tasks.py). Expects agent_input: day, items [{label, time, statement,
    related: [statement], current: the item's entry on the brain's list, or None}], situation (subconscious/
    situation.py, rendered by shared/brain/situation.j2), correction. Times are shown local. -#}
{%- set A = agent_input -%}
## Today's calendar ({{ A.day }})
{% for it in A["items"] %}
[{{ it.label }}] {{ "All day" if it.time == "all day" else "At " ~ it.time }}: {{ it.statement }}
{%- for r in it.related %}
    read with: {{ r }}
{%- endfor %}
{%- if it.current %}
    on the list now: {% if it.current.decision == "needed" %}needed: {{ it.current.who_acts }}: {{ it.current.assistant_part }}, {{ it.current.when }}{% else %}{{ it.current.decision | replace("_", " ") }}: {{ it.current.why }}{% endif %}
{%- endif %}
{%- endfor %}

{% with s = A.situation %}{% include 'shared/brain/situation.j2' %}{% endwith %}
{% if A.correction %}
## Your previous answer was refused
{{ A.correction }}
{% endif %}
Decide every item, by its label.
