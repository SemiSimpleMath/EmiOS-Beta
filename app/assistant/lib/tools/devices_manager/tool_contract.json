{
  "name": "devices_manager",
  "description": "Smart-home manager for Nest thermostat, Alexa lights, and Ring controls.",
  "inputs": [
    {
      "name": "task",
      "type": "string",
      "required": true,
      "description": "Requested smart-home task."
    },
    {
      "name": "information",
      "type": "string",
      "required": true,
      "description": "Supporting details and constraints."
    }
  ],
  "outputs": [
    {
      "path": "content",
      "type": "text",
      "description": "Human-readable result."
    },
    {
      "path": "data",
      "type": "object",
      "description": "Structured manager output."
    }
  ],
  "arguments_prompt": "Arguments to devices_manager:\n- task: required description of the smart-home action(s) to perform.\n- information: optional supporting context (device IDs, constraints, safety preferences).",
  "metadata": {
    "min_authority": 95,
    "approval_min_authority": 95,
    "domain": "orchestration",
    "actions": [
      "orchestrate",
      "control"
    ],
    "selectors": [
      "devices",
      "thermostat",
      "lights",
      "camera"
    ],
    "risk_level": "medium",
    "side_effects": "external_action",
    "requires_auth": [],
    "requires_network": false,
    "cost_level": "medium",
    "latency_class": "moderate",
    "front_door": false,
    "room_visibility_default": "conditional",
    "approval_required": false
  }
}
