{
  "name": "install_tool",
  "description": "Install a trusted MCP tool and register it for immediate use.",
  "inputs": [
    {
      "name": "tool_name",
      "type": "string",
      "required": false,
      "description": "Namespaced MCP tool, e.g. mcp::npm/server-google-maps::maps_distance_matrix."
    },
    {
      "name": "server_id",
      "type": "string",
      "required": false,
      "description": "Trusted MCP server_id, e.g. npm/server-google-maps."
    },
    {
      "name": "mcp_tool_name",
      "type": "string",
      "required": false,
      "description": "MCP tool name from the selected server, e.g. maps_distance_matrix."
    },
    {
      "name": "install_source",
      "type": "string",
      "required": false,
      "description": "Install source tag for registry metadata."
    },
    {
      "name": "launch_id",
      "type": "string",
      "required": false,
      "description": "Optional launch option id from server entry."
    },
    {
      "name": "timeout_s",
      "type": "number",
      "required": false,
      "description": "Timeout in seconds for cache refresh launch when needed."
    }
  ],
  "outputs": [
    {
      "path": "data.tool_name",
      "type": "tool_name",
      "description": "Installed namespaced MCP tool."
    },
    {
      "path": "data.ready_for_planner",
      "type": "boolean",
      "description": "True when tool is registered and discoverable."
    },
    {
      "path": "data.cache_refreshed",
      "type": "boolean",
      "description": "True when install triggered cache refresh."
    }
  ],
  "arguments_prompt": "{\"tool_name\": \"mcp::npm/server-google-maps::maps_distance_matrix\", \"install_source\": \"agent\", \"timeout_s\": 15.0}",
  "metadata": {
    "domain": "tooling",
    "actions": [
      "install"
    ],
    "selectors": [
      "tooling"
    ],
    "risk_level": "high",
    "side_effects": "write",
    "requires_auth": [],
    "requires_network": false,
    "cost_level": "low",
    "latency_class": "fast",
    "front_door": true,
    "room_visibility_default": "show",
    "approval_required": true
  }
}
