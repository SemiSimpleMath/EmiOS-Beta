{
  "name": "web_navigate_snapshot",
  "description": "Navigate to URL and bundle browser_snapshot refs in the same result.",
  "inputs": [
    {
      "name": "url",
      "type": "string",
      "required": false,
      "description": "Absolute URL to navigate to."
    }
  ],
  "outputs": [
    {
      "path": "content",
      "type": "text",
      "description": "Navigation status plus bundled browser_snapshot text."
    },
    {
      "path": "data.snapshot_text",
      "type": "string",
      "description": "Bundled browser_snapshot output with refs."
    },
    {
      "path": "data.snapshot_id",
      "type": "string",
      "description": "Unique id for this bundled snapshot capture."
    }
  ],
  "arguments_prompt": "Return ONLY {\"url\":\"https://...\"}",
  "metadata": {
    "domain": "browser",
    "actions": [
      "navigate"
    ],
    "selectors": [
      "url"
    ]
  }
}
