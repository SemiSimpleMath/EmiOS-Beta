{
  "name": "set_screen_capture_enabled",
  "description": "Enable or disable screen capture toggle for screenshot tools.",
  "inputs": [
    {
      "name": "enabled",
      "type": "boolean",
      "required": true,
      "description": "True to enable screen capture, False to disable it."
    },
    {
      "name": "actor",
      "type": "string",
      "required": false,
      "description": "Actor label, for example user or system."
    },
    {
      "name": "reason",
      "type": "string",
      "required": false,
      "description": "Optional reason when disabling."
    }
  ],
  "outputs": [
    {
      "path": "content",
      "type": "text",
      "description": "Status text."
    },
    {
      "path": "data.control.enabled",
      "type": "boolean",
      "description": "Resulting toggle state."
    }
  ],
  "arguments_prompt": "{\"enabled\": true, \"actor\": \"system\"}",
  "metadata": {
    "min_authority": 95,
    "approval_min_authority": 95,
    "domain": "vision",
    "actions": [
      "update"
    ],
    "selectors": [
      "vision"
    ],
    "risk_level": "medium",
    "side_effects": "write",
    "requires_auth": [],
    "requires_network": true,
    "cost_level": "high",
    "latency_class": "slow",
    "front_door": false,
    "room_visibility_default": "conditional",
    "approval_required": false
  }
}
