# Build context hygiene. Without this the whole repo — .git, the virtualenv,
# local data — is sent to the daemon on every build.
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.pyc
*.pyo

# Local state that must never be baked into an image.
.env
.env.*
!.env.example
data/
logs/
uploads/
instance/
chroma_db/
*.db
*.db-shm
*.db-wal

# Retired code — not needed at runtime, and it is large.
_archived/

# Test/CI scratch
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage

# ── Private / live personal data ─────────────────────────────────────────────
# The reference image is meant to be built from a CLEAN CLONE. On a machine
# with a live EmiOS install, the trees COPYed into the image (app/, resources/,
# skills/) also hold gitignored personal data and credentials — these patterns
# keep a maintainer-machine build from baking them in. Mirrors .gitignore's
# private patterns; keep the two in sync when adding private paths.

# Credentials and tokens — NEVER in an image.
app/assistant/lib/credentials/
app/assistant/lib/core_tools/credentials/
app/certs/

# Live personal resources (runtime-generated or user-authored).
resources/user/resource_user_data.json
resources/user/user_bio.json
resources/user/resource_wiki_sections.json
resources/user/.setup_draft.json
resources/resource_emi_accounts.json
resources/env_registry_user.json
resources/assistant/assistant_core.json
resources/assistant/resource_assistant_data.json
resources/assistant/resource_assistant_personality_data.json
resources/assistant/resource_chat_guidelines_data.json
resources/assistant/resource_relationship_config.json
resources/subconscious/
resources/identity/
resources/instructions/
resources/context/user/
resources/context/global/resource_weather.json
resources/context_engine/
resources/dayflow_pipeline_outputs/
resources/daily_insights_pipeline_outputs/
resources/weekly_insights_pipeline_outputs/
resources/kg_derived/
resources/status/
resources/day_context/
resources/resource_routine_status.json
resources/resource_user_location.json
resources/resource_current_location.json
skills/private/
app/assistant/rooms/justin/
app/assistant/user_settings_manager/user_settings_data/user_settings.json
app/subconscious_digests/
app/static/temp_audio/
app/chroma_db/
contrib_log/

# ── Seed templates must survive the excludes above ───────────────────────────
# bootstrap._seed_personal_resources() copies .example -> .json on first run,
# reading the templates from the CODE layer. The private-data patterns above
# exclude whole directories (resources/instructions/, resources/subconscious/),
# which also swallowed the sanitized .example templates living in them — so a
# fresh-volume container had nothing to seed from.
#
# .example files are sanitized templates by definition and are tracked in git,
# so re-including all of them is safe and keeps this working if new seeds are
# added later. Must come AFTER the excludes: last matching pattern wins.
!**/*.example
